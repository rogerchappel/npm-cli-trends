{
  "name": "npm-cli-trends",
  "version": "0.1.0",
  "description": "Daily public npm metadata snapshots for widely used CLI and developer tooling packages.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "validate": "node scripts/validate.mjs",
    "smoke": "node scripts/api.mjs summary --date latest",
    "release:check": "npm run validate && npm run smoke"
  },
  "keywords": [
    "npm",
    "cli",
    "metadata",
    "package-trends",
    "developer-tools"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/npm-cli-trends.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/npm-cli-trends/issues"
  },
  "homepage": "https://github.com/rogerchappel/npm-cli-trends#readme"
}
